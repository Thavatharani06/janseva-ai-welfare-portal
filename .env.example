# JanSeva AI Environment Configuration Example
# DO NOT COMMIT REAL PRODUCTION SECRETS OR TOKENS

# Server Settings
PROJECT_NAME="JanSeva AI - Multilingual Legal Welfare Assistant"
SECRET_KEY="generate-a-secure-random-secret-key-here"
DATABASE_URL="sqlite+aiosqlite:///./legal_welfare.db"

# LLM / RAG Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# DigiLocker / API Setu Official Integration
DIGILOCKER_ENABLED="false"
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
DIGILOCKER_REDIRECT_URI="http://localhost:8501/digilocker/callback"
DIGILOCKER_AUTH_URL="https://api.apisetu.gov.in/digilocker/v1/oauth2/authorize"
DIGILOCKER_TOKEN_URL="https://api.apisetu.gov.in/digilocker/v1/oauth2/token"
DIGILOCKER_ISSUED_DOCS_URL="https://api.apisetu.gov.in/digilocker/v1/oauth2/file/issued"

# LPG & Subsidy Government Service Integration
LPG_ENABLED="false"
LPG_API_URL=""
LPG_API_KEY=""
